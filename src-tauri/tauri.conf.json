{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProverkaZadaniy",
  "version": "1.5.1",
  "identifier": "com.spezio.proverka",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Проверка заданий",
        "width": 1380,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
